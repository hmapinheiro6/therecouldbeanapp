# Copy to .dev.vars. Never commit real secrets. No production bypass exists.
INTERNAL_SECRET=replace-with-at-least-32-random-bytes
RATE_LIMIT_SALT=replace-with-a-separate-32-byte-secret
TURNSTILE_SECRET_KEY=replace-with-real-secret
# Public settings live in wrangler.jsonc. Turnstile official test keys for local only:
# sitekey 1x00000000000000000000AA; secret 1x0000000000000000000000000000000AA

# Private admin access: use a separate generated 32-byte key.
ADMIN_SECRET=replace-with-a-separate-random-admin-key
