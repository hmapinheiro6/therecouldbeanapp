{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "therecouldbeanapp",
  "main": "worker/index.ts",
  "minify": true,
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/apps/*", "/sitemap.xml"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "therecouldbeanapp-catalog",
      "database_id": "2a24c33c-ee1f-4dba-b601-39f00232e3ea",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "SITE_URL": "https://therecouldbeanapp.henriquepinheiro.workers.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGCZ4047ac7iauOi",
    "TURNSTILE_HOSTNAME": "therecouldbeanapp.henriquepinheiro.workers.dev",
    "INGESTION_ENABLED": "true",
    "SUBMISSIONS_ENABLED": "true",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 0.1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
    "redact_query_string": true,
  },
  "account_id": "272cf24b9368ff4a4c6833562cae0f0d",
  "preview_urls": false,
}
